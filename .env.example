# Runtime environment
APP_ENV=development

# Inventory API and sellers (F3)
API_HOST=0.0.0.0
API_PORT=8000

# Deterministic inventory configuration
MASTER_SEED=42
MAX_STOCK=450

# Seller configuration (Sellers)
ERROR_RATE=0.03
ENABLE_NEGATIVE_INVENTORY=true

# Valid tokens for authentication (comma-separated)
VALID_TOKENS=token-seller-123,bearer-token-mercaandes-2026,test-token

# PostgreSQL (optional, for sellers and stock persistence)
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_NAME=change_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me
